# MediLens AI - .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python environments
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type-checking caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.eslintcache

# Frontend build outputs
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo

# Sensitive credentials & environment variables
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Healthcare Data & Artifact Protection (Strictly no real claim or patient data)
data/raw/*
data/processed/*
data/phi/*
*.csv
*.parquet
*.xlsx
*.sqlite
*.db

# Local model, metric, and explanation artifacts
models/
