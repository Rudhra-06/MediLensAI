# MediLens AI - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN LOCAL VALUES. NEVER COMMIT .env TO VERSION CONTROL.

# Application Environment
MEDILENS_ENV=development
DEBUG=true

# Local retrospective demo only; requires MEDILENS_ENV=development and loopback API access.
# Enables a small anonymous selector backed by held-out validation rows in memory.
LOCAL_PROVIDER_DEMO_ENABLED=false

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api
APP_NAME="MediLens AI"
APP_VERSION=0.1.0

# CORS Configuration (comma-separated list of allowed origins)
# For local frontend development, use the Vite dev server origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment Variable
# Points the React frontend to the FastAPI backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Future Database (PostgreSQL - Planned for future steps)
# DATABASE_URL=postgresql://user:password@localhost:5432/medilens_ai

# Future ML Model Storage (Planned for future steps)
# MODEL_PATH=models/claim_fraud_xgboost_v1.joblib
